# 실제 키는 .env.local 또는 Vercel 대시보드에만 넣으세요.
# 이 파일에는 값을 적지 않습니다.

GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=

# Firebase 웹 앱 설정
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (서버 전용)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Drive OAuth (서버 전용)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/drive/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# 위치 시뮬(/admin/test/location-sim)은 로컬 next dev 에서만 기본 켜집니다.
# 운영 빌드(npm run build)에서 true 이면 빌드가 중단됩니다.
# 개발에서도 끄려면 false.
# NEXT_PUBLIC_ENABLE_LOCATION_SIM=
